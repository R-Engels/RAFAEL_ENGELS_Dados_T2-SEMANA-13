// medidas.dax - Controladoria PNCP (Power BI)
// Tabela: fato_item_contratado | dimensoes: dim_orgao, dim_fornecedor, dim_modalidade, dim_localidade, Calendario
// Crie primeiro a tabela vazia "_Medidas" (Inserir dados > tabela vazia, ou: _Medidas = ROW("x", 1) e oculte a coluna).
// Pastas de exibicao: uma por pergunta (campo "Pasta de exibicao" no painel Modelo).

// ======================= CALENDARIO (tabela calculada) =======================
// Limites vindos dos dados. Marcar como tabela de datas (Ferramentas de tabela > Marcar como tabela de datas > Data).
// Ordenar: Mes (nome) por Mes Num; Ano-Mes por AnoMes Num. Desligar "Hora/data automatica" nas opcoes do arquivo.
Calendario =
VAR _ini = MIN ( MIN ( fato_item_contratado[data_publicacao] ), MIN ( fato_item_contratado[data_homologacao] ) )
VAR _fim = MAX ( MAX ( fato_item_contratado[data_publicacao] ), MAX ( fato_item_contratado[data_homologacao] ) )
RETURN
    ADDCOLUMNS (
        CALENDAR ( DATE ( YEAR ( _ini ), 1, 1 ), DATE ( YEAR ( _fim ), 12, 31 ) ),
        "Ano", YEAR ( [Date] ),
        "Mes Num", MONTH ( [Date] ),
        "Mes", FORMAT ( [Date], "mmm", "pt-BR" ),
        "AnoMes Num", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
        "Ano-Mes", FORMAT ( [Date], "yyyy-mm" )
    )
// Renomear a coluna [Date] para [Data] no modelo (ou ajustar as referencias).
// Relacionamentos: Calendario[Data] 1:N fato[data_publicacao] (ATIVO) e Calendario[Data] 1:N fato[data_homologacao] (INATIVO).

// ======================= P1 ECONOMIA (pasta "P1 Economia") =======================
1 Valor Estimado Comparavel =
CALCULATE ( SUM ( fato_item_contratado[valor_total_estimado] ), fato_item_contratado[comparavel] = 1 )

2 Volume Homologado =
SUM ( fato_item_contratado[valor_total_homologado] )

3 Economia (R$) =
VAR _estimado = [1 Valor Estimado Comparavel]
VAR _homologado =
    CALCULATE ( [2 Volume Homologado], fato_item_contratado[comparavel] = 1 )
RETURN
    _estimado - _homologado

4 Economia % =
DIVIDE ( [3 Economia (R$)], [1 Valor Estimado Comparavel] )

5 % de Itens Comparaveis =
VAR _comparaveis = CALCULATE ( COUNTROWS ( fato_item_contratado ), fato_item_contratado[comparavel] = 1 )
VAR _total = COUNTROWS ( fato_item_contratado )
RETURN
    DIVIDE ( _comparaveis, _total )

// ======================= P2 FORNECEDORES (pasta "P2 Fornecedores") =======================
6 Participacao do Fornecedor % =
VAR _volume = [2 Volume Homologado]
VAR _total = CALCULATE ( [2 Volume Homologado], ALL ( dim_fornecedor ) )
RETURN
    DIVIDE ( _volume, _total )

7 Ranking do Fornecedor =
RANKX ( ALL ( dim_fornecedor[nome_fornecedor] ), [2 Volume Homologado], , DESC, DENSE )

8 Concentracao Top 10 % =
VAR _total = CALCULATE ( [2 Volume Homologado], ALL ( dim_fornecedor ) )
VAR _top10 = TOPN ( 10, ALL ( dim_fornecedor[sk_fornecedor] ), [2 Volume Homologado], DESC )
VAR _volumeTop10 =
    CALCULATE ( [2 Volume Homologado], KEEPFILTERS ( _top10 ) )
RETURN
    DIVIDE ( _volumeTop10, _total )

Pareto Fornecedor % =
VAR _rank = [7 Ranking do Fornecedor]
VAR _total = CALCULATE ( [2 Volume Homologado], ALL ( dim_fornecedor ) )
VAR _acum =
    CALCULATE (
        [2 Volume Homologado],
        FILTER (
            ALL ( dim_fornecedor[nome_fornecedor] ),
            [7 Ranking do Fornecedor] <= _rank
        )
    )
RETURN
    DIVIDE ( _acum, _total )

// ======================= P3 MODALIDADES (pasta "P3 Modalidades") =======================
// Mesma medida serve para modalidade, UF, regiao e perfil: usa o contexto da linha (ALLSELECTED mantem filtros de pagina/segmentacao).
9 Participacao no Volume % =
VAR _linha = [2 Volume Homologado]
VAR _total = CALCULATE ( [2 Volume Homologado], ALLSELECTED () )
RETURN
    DIVIDE ( _linha, _total )

10 Desagio vs Media Geral (p.p.) =
// Formatar como numero com 1 casa decimal (NAO como %).
VAR _linha = [4 Economia %]
VAR _geral = CALCULATE ( [4 Economia %], REMOVEFILTERS () )
RETURN
    IF ( NOT ISBLANK ( _linha ), ( _linha - _geral ) * 100 )

// ======================= P4 CICLO (pasta "P4 Ciclo") =======================
11 Ciclo Medio (dias) =
AVERAGE ( fato_item_contratado[dias_ciclo] )

12 Ciclo Maximo (dias) =
MAX ( fato_item_contratado[dias_ciclo] )

13 Itens sem Ciclo =
VAR _total = COUNTROWS ( fato_item_contratado )
VAR _comCiclo = COUNT ( fato_item_contratado[dias_ciclo] )
RETURN
    _total - _comCiclo

// ======================= P5 REGIONAL (pasta "P5 Regional") =======================
14 Qtd Unidades Compradoras =
DISTINCTCOUNT ( fato_item_contratado[sk_orgao] )
// Conta sobre a fato (1 sk_orgao = 1 CNPJ): exclui a linha sk=-1 da dimensao, que nenhuma linha da fato usa. Total = 363.

// ======================= P6 PERFIL (pasta "P6 Perfil") =======================
15 Ticket Medio por Item (R$) =
VAR _volume = [2 Volume Homologado]
VAR _itens = COUNTROWS ( fato_item_contratado )
RETURN
    DIVIDE ( _volume, _itens )

// ======================= EXTRAS opcionais (pasta "Extras") =======================
Itens com Sobrepreco =
// Iteradora: conta itens comparaveis com homologado > estimado
COUNTROWS (
    FILTER (
        fato_item_contratado,
        fato_item_contratado[comparavel] = 1
            && fato_item_contratado[valor_total_homologado] > fato_item_contratado[valor_total_estimado]
    )
)

Economia por Item Iterada (R$) =
// Iteradora SUMX equivalente a medida 3 (conferencia cruzada)
SUMX ( fato_item_contratado, fato_item_contratado[economia_valor] )

Volume Acumulado no Ano =
VAR _dataMax = MAX ( Calendario[Data] )
RETURN
    CALCULATE (
        [2 Volume Homologado],
        FILTER ( ALL ( Calendario ), Calendario[Ano] = YEAR ( _dataMax ) && Calendario[Data] <= _dataMax )
    )

Titulo Dinamico do Tooltip =
VAR _nome = SELECTEDVALUE ( dim_modalidade[nome_modalidade], "Todas as modalidades" )
RETURN
    "Detalhe: " & _nome

// Valores de referencia (devem bater com sql/02_perguntas.sql):
//  Estimado Comparavel R$ 6.867.663.469,91 | Volume R$ 8.044.498.805,74 | Economia R$ 992.861.686,95 | Economia % 14,46%
//  Itens comparaveis 5.457/6.126 = 89,1% | Top 10 fornecedores = 41,43% | Ciclo medio 48,1 | Maximo 611 | Sem ciclo 230
//  Unidades compradoras 363 | Ticket medio = Volume/6.126 itens (confira: SELECT SUM(valor_total_homologado)/COUNT(*) na fato)
